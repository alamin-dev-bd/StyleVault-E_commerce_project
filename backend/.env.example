# =====================================================================
# Django core
# =====================================================================
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
# Used by Docker and Render. Locally, manage.py already defaults to development.
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# =====================================================================
# Database - Neon PostgreSQL  (keep ?sslmode=require)
# =====================================================================
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_CONN_MAX_AGE=0

# =====================================================================
# Cloudinary (leave empty locally to store uploads in backend/media/)
# =====================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================================
# Email (console backend just prints emails in the terminal)
# =====================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fashion Store <no-reply@example.com>

# =====================================================================
# SSLCommerz (possible online payment gateway) - sandbox credentials first
# =====================================================================
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=True